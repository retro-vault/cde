file(GLOB_RECURSE resources
    ${PREFIX}/share/dt/app-defaults/* ${PREFIX}/share/dt/config/*
    ${PREFIX}/share/dt/appconfig/types/*)
file(GLOB_RECURSE families ${PREFIX}/share/dt/appconfig/help/*.hf)
list(APPEND resources ${families})
file(GLOB descriptions ${PREFIX}/share/dt/backdrops/desc.* ${PREFIX}/share/dt/palettes/desc.*)
list(APPEND resources ${descriptions})
foreach(resource IN LISTS resources)
    if(NOT IS_DIRECTORY ${resource})
        file(READ ${resource} content)
        if(content MATCHES "%\\|nls-[0-9]" OR content MATCHES "@CDE_[A-Z_]+@")
            message(FATAL_ERROR "Installed resource still contains a template: ${resource}")
        endif()
    endif()
endforeach()
foreach(required app-defaults/C/Dtcm app-defaults/C/Dthelpview backdrops/desc.C palettes/desc.C)
    if(NOT EXISTS ${PREFIX}/share/dt/${required})
        message(FATAL_ERROR "Desktop resource is missing: ${required}")
    endif()
endforeach()
foreach(required config/ims/start.conf config/ims/none config/ims/ja_JP.UTF-8)
    if(NOT EXISTS ${PREFIX}/share/dt/${required})
        message(FATAL_ERROR "Input-method configuration is missing: ${required}")
    endif()
endforeach()

foreach(locale en_US.UTF-8 de_DE.UTF-8 es_ES.UTF-8 fr_FR.UTF-8 it_IT.UTF-8 ja_JP.UTF-8)
    foreach(family Desktop DesktopIntro)
        if(NOT EXISTS ${PREFIX}/share/dt/appconfig/help/${locale}/${family}.hf)
            message(FATAL_ERROR "Missing help registration: ${locale}/${family}.hf")
        endif()
    endforeach()
endforeach()
foreach(required libexec/cde/dtinfo_start libexec/cde/ttsession libexec/cde/rpc.ttdbserver
        libexec/cde/rpc.cmsd libexec/cde/xephyr-resize bin/dthelpprint.sh
        share/dt/infolib/etc/mmdb.mark.spec
        share/dt/appconfig/tttypes/types.xdr share/dt/infolib/C/cde.dti
        share/dt/appconfig/help/C/Desktop.hf share/dt/config/Xsession.d/0010.dtpaths)
    if(NOT EXISTS ${PREFIX}/${required})
        message(FATAL_ERROR "Missing installed runtime component: ${required}")
    endif()
endforeach()
file(GLOB commands ${PREFIX}/bin/*)
foreach(command IN LISTS commands)
    if(NOT IS_DIRECTORY ${command})
        execute_process(COMMAND test -x ${command} RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Installed command is not executable: ${command}")
        endif()
    endif()
endforeach()
