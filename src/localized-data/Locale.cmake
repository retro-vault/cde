get_filename_component(locale ${CMAKE_CURRENT_SOURCE_DIR} NAME)
file(GLOB_RECURSE translation_messages CONFIGURE_DEPENDS *.tmsg)
get_property(resources GLOBAL PROPERTY CDE_TRANSLATABLE_RESOURCES)
foreach(resource IN LISTS resources)
    string(REPLACE "|" ";" fields "${resource}")
    list(GET fields 0 output)
    list(GET fields 1 input)
    list(GET fields 2 default_messages)
    list(GET fields 3 destination)
    get_filename_component(message_name ${default_messages} NAME)
    set(messages)
    foreach(candidate IN LISTS translation_messages)
        get_filename_component(candidate_name ${candidate} NAME)
        if(candidate_name STREQUAL message_name)
            set(messages ${candidate})
            break()
        endif()
    endforeach()
    if(messages)
        string(REGEX REPLACE "/C(/|$)" "/${locale}\\1" destination "${destination}")
        string(REGEX REPLACE "\\.C$" ".${locale}" output "${output}")
        cde_localized_resource(${output} ${input} ${messages} ${destination}
            DEFAULT_MESSAGES ${default_messages})
    endif()
endforeach()
get_property(catalogs GLOBAL PROPERTY CDE_MESSAGE_CATALOGS)
list(REMOVE_DUPLICATES catalogs)
foreach(catalog IN LISTS catalogs)
    set(input ${CMAKE_CURRENT_SOURCE_DIR}/msg/${catalog}.msg)
    if(EXISTS ${input})
        if(catalog STREQUAL dtprintinfo)
            file(MAKE_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/printer-messages)
            set(input ${CMAKE_CURRENT_BINARY_DIR}/printer-messages/dtprintinfo.msg)
            add_custom_command(OUTPUT ${input}
                COMMAND ${CMAKE_COMMAND} -DSHELL=${KSH_EXECUTABLE}
                    -DCPP=$<TARGET_FILE:tradcpp> -DSCRIPT=${PROJECT_SOURCE_DIR}/src/dtprintinfo/sym2num
                    -DINPUT=${CMAKE_CURRENT_SOURCE_DIR}/msg/dtprintinfo.msg
                    -DWORK_DIR=${CMAKE_CURRENT_BINARY_DIR}/printer-messages
                    -P ${CMAKE_CURRENT_LIST_DIR}/GeneratePrinterCatalog.cmake
                DEPENDS tradcpp ${CMAKE_CURRENT_SOURCE_DIR}/msg/dtprintinfo.msg VERBATIM)
        endif()
        cde_message_catalog(${catalog} LOCALE ${locale} ${input})
    endif()
endforeach()
