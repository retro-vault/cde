file(COPY ${SOURCE_DIR}/ DESTINATION ${OUTPUT_DIR})
set(modules ttsnoop apiTracer ttChooser patternProps stringChooser messageProps sessionChooser fileChooser argChooser callbackChooser)
configure_file(${SOURCE_DIR}/ttsnoop.C.src ${OUTPUT_DIR}/ttsnoop.c COPYONLY)
foreach(module IN LISTS modules)
    configure_file(${SOURCE_DIR}/${module}_stubs.C.src ${OUTPUT_DIR}/${module}_stubs.c COPYONLY)
endforeach()
execute_process(COMMAND ${CODEGEN} -merge -p ttsnoop.bip -main
    WORKING_DIRECTORY ${OUTPUT_DIR} OUTPUT_FILE ${OUTPUT_DIR}/main.log COMMAND_ERROR_IS_FATAL ANY)
set(bils)
foreach(module IN LISTS modules)
    list(APPEND bils ${module}.bil)
endforeach()
execute_process(COMMAND ${CODEGEN} -merge -p ttsnoop.bip ${bils}
    WORKING_DIRECTORY ${OUTPUT_DIR} OUTPUT_FILE ${OUTPUT_DIR}/modules.log COMMAND_ERROR_IS_FATAL ANY)
file(RENAME ${OUTPUT_DIR}/ttsnoop.c ${OUTPUT_DIR}/ttsnoop.C)
foreach(module IN LISTS modules)
    file(RENAME ${OUTPUT_DIR}/${module}_stubs.c ${OUTPUT_DIR}/${module}_stubs.C)
endforeach()
file(READ ${SOURCE_DIR}/externC.h begin)
file(READ ${SOURCE_DIR}/closeBrace.h end)
foreach(header dtb_utils.h ttsnoop_ui.h apiTracer_ui.h ttChooser_ui.h patternProps_ui.h stringChooser_ui.h messageProps_ui.h sessionChooser_ui.h fileChooser_ui.h argChooser_ui.h callbackChooser_ui.h)
    file(READ ${OUTPUT_DIR}/${header} content)
    file(WRITE ${OUTPUT_DIR}/${header} "${begin}\n${content}\n${end}")
endforeach()
file(READ ${OUTPUT_DIR}/ttsnoop_ui.c content)
string(REGEX REPLACE "(^|\n)DtbTt" "\\1extern String snooperArgv[];DtbTt" content "${content}")
foreach(property "XmNheight, 257," "XmNwidth, 580," "XmNcolumns, 80,")
    string(REPLACE "${property}" "" content "${content}")
endforeach()
string(REPLACE "XmNrows, 24" "DtNsubprocessArgv, snooperArgv" content "${content}")
file(WRITE ${OUTPUT_DIR}/ttsnoop_ui.c "${content}")
file(READ ${OUTPUT_DIR}/apiTracer_ui.c content)
string(REGEX REPLACE "(^|\n)DtbApi" "\\1extern String apiTracerArgv[];DtbApi" content "${content}")
string(REPLACE "XmNrows, 24" "XmNrows, 24, DtNsubprocessArgv, apiTracerArgv" content "${content}")
file(WRITE ${OUTPUT_DIR}/apiTracer_ui.c "${content}")
file(READ ${OUTPUT_DIR}/dtb_utils.c content)
string(REPLACE "MoreButton;" "MoreButton;Boolean _DtCanHelp(const char *);" content "${content}")
string(REPLACE "XtManageChild(Quick_help" "XtSetSensitive(MoreButton,_DtCanHelp(help_data->help_text));XtManageChild(Quick_help" content "${content}")
string(REPLACE "buffer, vol = NULL, loc = NULL;" "buffer, vol = NULL, loc = NULL;Boolean _DtHelped(Widget);" content "${content}")
string(REPLACE "if( (cp=strrchr" "if (_DtHelped(help_dialog)) return;if( (cp=strrchr" content "${content}")
file(WRITE ${OUTPUT_DIR}/dtb_utils.c "${content}")
file(TOUCH ${OUTPUT_DIR}/generated.stamp)
