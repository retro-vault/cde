#      ************** DO NOT EDIT THIS FILE **************
#
#  @CDE_DATA_TOP@/config/Xsetup is a factory-default file and will
#  be unconditionally overwritten upon subsequent installation.
#  Before making changes to the file, copy it to the configuration 
#  directory, @CDE_CONFIGURATION_TOP@/config. You must also update the setup
#  resource in @CDE_CONFIGURATION_TOP@/config/Xconfig.
#
# ##########################################################################
# ##########################################################################
# 
# Directory specifications
# 
# ##########################################################################



  XDIR=/usr/bin




# ##########################################################################
#  
# Append desktop font aliases to font path
#
# ##########################################################################


    #
    # Append desktop font paths. Note: these directories should be
    # accessable by the X server. The file precedence is:
    #
    #   @CDE_CONFIGURATION_TOP@/fontaliases
    #   @CDE_DATA_TOP@/fontaliases
    #
    if [ "$DTXSERVERLOCATION" != "remote" ]; then
      #
      # Since X server is local, optimize by checking local desktop
      # font directories and making one call to xset.
      #

      if [ -f @CDE_CONFIGURATION_TOP@/fontaliases/fonts.dir ] || \
         [ -f @CDE_CONFIGURATION_TOP@/fontaliases/fonts.alias ]; then
        fontpath=@CDE_CONFIGURATION_TOP@/fontaliases
      fi

      if [ -f @CDE_DATA_TOP@/fontaliases/fonts.dir ] || \
         [ -f @CDE_DATA_TOP@/fontaliases/fonts.alias ]; then
        if [ -z "$fontpath" ]; then
          fontpath=@CDE_DATA_TOP@/fontaliases
        else
          fontpath=$fontpath,@CDE_DATA_TOP@/fontaliases
        fi
      fi


      if [ ! -z "$fontpath" ]; then
        $XDIR/xset fp+ $fontpath
      fi

    else
      #
      # Since X server not local, we don't know if the desktop font
      # directories exist on the X server machine, so we have to
      # set them one at a time.
      #

      $XDIR/xset fp+ @CDE_CONFIGURATION_TOP@/fontaliases 1>/dev/null

      $XDIR/xset fp+ @CDE_DATA_TOP@/fontaliases 1>/dev/null

    fi


    if [ "$DTXSERVERLOCATION" != "remote" ]; then
      fontpath=
      FONTLIB=/usr/share/fonts/X11
      for i in misc 75dpi 100dpi Speedo Type1 PJE
      do
	 if [ -f $FONTLIB/$i/fonts.dir ];  then
	     if [ ! -z "$fontpath" ]; then
		fontpath=$fontpath,$FONTLIB/$i/
	     else
		fontpath=$FONTLIB/$i/
	     fi
	 fi
      done

      if [ ! -z "$fontpath" ]; then
        $XDIR/xset fp+ $fontpath
      fi
    fi



